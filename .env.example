# Copy to .env for local overrides. Explicit Settings values > process environment > .env > defaults.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/mortgage_pricing.db
# Maximum SQLite lock wait in seconds: greater than 0 and at most 30.
SQLITE_BUSY_TIMEOUT_SECONDS=5
DEMO_IDENTITY_MODE=off
UI_API_URL=http://127.0.0.1:8000

# off disables model-related activity; auto is reserved for capability discovery only.
LLM_MODE=off
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TIMEOUT_SECONDS=30
