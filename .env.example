# Copy to .env for local overrides. Explicit Settings values > process environment > .env > defaults.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/mortgage_pricing.db
# Maximum SQLite lock wait in seconds: greater than 0 and at most 30.
SQLITE_BUSY_TIMEOUT_SECONDS=5
DEMO_IDENTITY_MODE=off
SEED_DEMO_DATA=false
UI_TIMEOUT_SECONDS=10

# off makes no model calls. auto permits explicitly requested reviewer recommendations.
LLM_MODE=off
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TIMEOUT_SECONDS=30

# Compose uses its private Ollama service, independently of the local Python URL above.
# COMPOSE_LLM_BASE_URL=http://ollama:11434
# COMPOSE_LLM_TIMEOUT_SECONDS=120
# APP_PORT=8000
